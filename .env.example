# Copiar a .env (local) o cargar como variables de entorno en Render/Koyeb.
# NUNCA subir el archivo .env al repositorio.

# ---------------------------------------------------------------- MongoDB Atlas (obligatorio)
SAT_MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=1&appName=sat-maule
SAT_MONGO_DB=sat_maule
SAT_TELEMETRY_TTL_DAYS=90

# ---------------------------------------------------------------- Web Push (obligatorio para alertas)
# Generar con: python -m src.infrastructure.notifications.generate_vapid
SAT_VAPID_PRIVATE_KEY=
SAT_VAPID_PUBLIC_KEY=
SAT_VAPID_SUBJECT=mailto:alertas@su-dominio.cl

# ---------------------------------------------------------------- Seguridad
# Cadena aleatoria larga, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SAT_REPORTER_HASH_SECRET=
# Token del cron externo para POST /api/internal/monitor (vacío = endpoint deshabilitado)
SAT_CRON_TOKEN=

# ---------------------------------------------------------------- Monitor de zonas
# Minutos entre evaluaciones dentro del proceso. En hosting gratuito que "duerme",
# usar 0 y llamar /api/internal/monitor desde un cron externo (ver README).
SAT_MONITOR_INTERVAL_MIN=30

# ---------------------------------------------------------------- Opcional
# Sólo si el frontend se sirve desde OTRO dominio (por defecto PWA y API comparten origen).
# SAT_CORS_ORIGINS=["https://mi-frontend.example"]
SAT_WEATHER_CACHE_TTL_S=900

# PySpark (jobs batch/streaming opcionales)
SAT_SPARK_MASTER=local[*]
SAT_SPARK_DRIVER_MEMORY=2g

# Windy Point Forecast API (opcional): estudio por modelos GFS/ICON en Monitoreo.
# Clave en https://api.windy.com/keys (las claves de prueba devuelven datos desordenados).
SAT_WINDY_POINT_API_KEY=
